{
  "name": "ROS Iron Dev Container",
  "image": "ros-iron-explorer:saved",
  "workspaceFolder": "/src",
  "mounts": [
    "source=${localWorkspaceFolder},target=/src,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
  ],
  "remoteUser": "root",
  "environment": [
    "DISPLAY=${env:DISPLAY}"
  ]
}
